# audio2report — NVIDIA DGX Spark (GB10 Grace Blackwell) image
# Base: NVIDIA CUDA 13.0 + cuDNN on Ubuntu 24.04, arm64/sbsa.
#
# Why a separate Dockerfile instead of a build-arg variant of
# Dockerfile.gpu: DGX Spark's GB10 Superchip pairs a Grace CPU (genuinely
# ARM64 — Cortex-X925/A725 cores, not x86) with a Blackwell GPU (compute
# capability sm_121). Blackwell support only landed in CUDA 13.0;
# Dockerfile.gpu is pinned to CUDA 12.1, which predates Blackwell
# entirely and has no kernel support for it regardless of architecture.
# So this needs both a different base image architecture AND a different
# CUDA major version — two independent reasons, not one.
#
# Known open risks (unverified against real hardware as of writing —
# smoke-test before trusting this in production):
#   - Official PyTorch cu130 wheels are only officially validated up to
#     sm_120; DGX Spark is sm_121. Community reports say it runs with a
#     compatibility warning rather than failing outright, but confirm
#     this on real hardware.
#   - whisperx's native-compiled dependency chain (faster-whisper ->
#     ctranslate2) has a history of lagging on new-architecture CUDA
#     wheel availability — confirm `pip install ".[whisperx,diarize]"`
#     actually resolves working aarch64+CUDA13 wheels for everything it
#     pulls in, not just for plain torch.
#
# Usage:
#   docker build -f Dockerfile.dgx -t audio2report:dgx .
#   docker run --rm --gpus all \
#       -v ./recordings:/data/in:ro -v ./output:/data/out \
#       -e HF_TOKEN=$HF_TOKEN \
#       audio2report:dgx dual /data/in --out /data/out --diarize

FROM nvidia/cuda:13.0.0-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1

# Ubuntu 24.04 ships Python 3.12 natively — no versioned package needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-dev \
        python3-pip \
        ffmpeg \
        git \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /app

COPY pyproject.toml LICENSE .
COPY audio2report/ ./audio2report/
COPY configs/ ./configs/

# Install the aarch64+CUDA13 PyTorch build explicitly, before whisperx/
# pyannote pull in torch themselves — same ordering trick as
# Dockerfile.intel's TORCH_VARIANT install, so pip sees it already
# satisfied and doesn't reinstall a mismatched default build.
RUN pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cu130

RUN pip install --no-cache-dir ".[whisperx,diarize]"

ENV HF_HOME=/root/.cache/huggingface
VOLUME ["/root/.cache/huggingface", "/data/in", "/data/out"]

ENTRYPOINT ["audio2report"]
CMD ["--help"]
