# audio2report — NVIDIA DGX Spark (GB10 Grace Blackwell) image
# Base: NVIDIA CUDA 13.0 + cuDNN on Ubuntu 24.04, arm64/sbsa.
#
# Why a separate Dockerfile instead of a build-arg variant of
# Dockerfile.gpu: DGX Spark's GB10 Superchip pairs a Grace CPU (genuinely
# ARM64 — Cortex-X925/A725 cores, not x86) with a Blackwell GPU (compute
# capability sm_121). Blackwell support only landed in CUDA 13.0;
# Dockerfile.gpu is pinned to CUDA 12.1, which predates Blackwell
# entirely and has no kernel support for it regardless of architecture.
# So this needs both a different base image architecture AND a different
# CUDA major version — two independent reasons, not one.
#
# Built on real DGX Spark hardware (spark0, GB10, driver 580.159.03,
# CUDA 13.0). One real bug found in the process — see the
# --extra-index-url comment below; without it, this image silently ends
# up CPU-only despite the explicit torch install.
#
# Still-open risk, not yet hit but not ruled out either: official
# PyTorch cu130 wheels are only officially validated up to sm_120; DGX
# Spark is sm_121. Community reports say it runs with a compatibility
# warning rather than failing outright — watch for that warning on a
# real transcription run, not just at import time.
#
# Usage:
#   docker build -f Dockerfile.dgx -t audio2report:dgx .
#   docker run --rm --gpus all \
#       -v ./recordings:/data/in:ro -v ./output:/data/out \
#       -e HF_TOKEN=$HF_TOKEN \
#       audio2report:dgx dual /data/in --out /data/out --diarize

FROM nvidia/cuda:13.0.0-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1

# Ubuntu 24.04 ships Python 3.12 natively — no versioned package needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-dev \
        python3-pip \
        ffmpeg \
        git \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /app

COPY pyproject.toml LICENSE .
COPY audio2report/ ./audio2report/
COPY configs/ ./configs/

# Install the aarch64+CUDA13 PyTorch build explicitly, before whisperx/
# pyannote pull in torch themselves — same ordering trick as
# Dockerfile.intel's TORCH_VARIANT install. Unlike that image, ordering
# alone isn't enough here: whisperx's own dependency chain constrains
# torch to an older version than cu130's latest, so pip's resolver
# *downgrades* torch during the second install regardless of what's
# already present — confirmed on real DGX Spark hardware, where this
# silently landed on a CPU-only build from the default PyPI index
# because only the first install pointed at the CUDA index. Passing
# --extra-index-url on the second install too means that downgrade still
# resolves a CUDA build instead of falling back to a CPU one.
RUN pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cu130

RUN pip install --no-cache-dir ".[whisperx,diarize]" \
    --extra-index-url https://download.pytorch.org/whl/cu130

ENV HF_HOME=/root/.cache/huggingface
VOLUME ["/root/.cache/huggingface", "/data/in", "/data/out"]

ENTRYPOINT ["audio2report"]
CMD ["--help"]
